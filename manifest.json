{
  "manifest_version": 2,
  "name": "Regex Message Tagger",
  "version": "1.0",
  "permissions": [
    "messagesModify",
    "messagesRead",
	  "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "accountsRead",
    "menus",
    "tabs",
    "notifications",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "applications": {
    "gecko": {
      "id": "author.regex-message-tagger@addons.thunderbird.net",
      "strict_min_version": "115.0"
    }
  },
  "commands": {
    "run-tagging": {
      "suggested_key": { "default": "Ctrl+Alt+T" },
      "description": "Tag Folder with Subject Numbers"
    },
    "run-purge": {
      "suggested_key": { "default": "Ctrl+Alt+U" },
      "description": "Delete all SN tags"
    }
  }
}   